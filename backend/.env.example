# Backend runtime settings. Spring Boot does not load this file automatically;
# Local-only backend environment. Render must use the render profile and a persistent MySQL DB_URL.
SPRING_PROFILES_ACTIVE=local
PORT=8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-admin-password-at-least-8-characters

# Local development only; H2 memory data is lost when the backend process stops.
DB_URL=jdbc:h2:mem:leave_management;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=
DDL_AUTO=update
CORS_ORIGIN=*
